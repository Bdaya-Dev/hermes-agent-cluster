# Keep the build context small and secrets-safe: only the Python package and
# packaging metadata reach the daemon (see Dockerfile COPY lines).
.git
.github
.gitignore
.env
.env.*
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/
tests/
tests_v3/
dashboard/
plugins/
cluster*.db
cluster*.db-*
*.db
*.db-wal
*.db-shm
*.log
cluster-worker-*.yaml
run-*.cmd
run-*.bat
setup_wizard.py
hermes_launch.py
INSTALL.md
README*
!hermes_cluster/**
docs/
*.md
!pyproject.toml
!README.md
!hermes_cluster/static/**
